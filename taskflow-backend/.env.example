# ==============================================================================
# TaskFlow Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/task_system
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Security & JWT Authentication Configuration
# Must be at least 256 bits (32 bytes) long (e.g. 64-character hex string)
JWT_SECRET=your_jwt_secret_min_256_bit_hex_string_here
# Token expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000
# Refresh token expiration in milliseconds (604800000 ms = 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# File Storage Configuration
# Directory where project documents and files will be stored
UPLOAD_DIR=e:/Task System/uploads

# CORS Allowed Origins
# Comma-separated URLs permitted to make cross-origin requests to this backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
